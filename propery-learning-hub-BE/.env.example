APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Media uploads — set MEDIA_DISK_DRIVER=s3 and fill AWS_* below.
# Large files (videos, documents) upload directly from the browser to S3 via presigned URLs.
# Configure S3 bucket CORS (AWS Console → S3 → bucket → Permissions → CORS):
#   AllowedOrigins: your frontend URL(s), e.g. http://localhost:3000, https://your-app.amplifyapp.com
#   AllowedMethods: PUT, GET, HEAD
#   AllowedHeaders: *
#   ExposeHeaders: ETag
MEDIA_DISK_DRIVER=s3

# Video uploads require PHP upload_max_filesize/post_max_size >= 128M.
# See public/.user.ini and set nginx client_max_body_size 130M on production.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe — Academy enrollment payment
STRIPE_KEY=pk_test_your_publishable_key
STRIPE_SECRET=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=
STRIPE_ACADEMY_AMOUNT=300000
STRIPE_ACADEMY_CURRENCY=gbp
STRIPE_ACADEMY_PRODUCT_NAME="Freedom Property Journey"

# AWS S3 — only these 4 values required (URL is built automatically from bucket + region)
# IAM user needs: s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket on the bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=your-bucket-name
# Optional CloudFront or custom CDN base URL (otherwise https://{bucket}.s3.{region}.amazonaws.com)
# AWS_URL=

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000
# Comma-separated extra frontend origins (optional). www/non-www variants of FRONTEND_URL are added automatically.
# CORS_ALLOWED_ORIGINS=https://freedompropertyacademy.com,https://www.freedompropertyacademy.com

# Microsoft Graph / Teams — Admin Calendar (client credentials)
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Single admin mailbox — all meetings are created here (no OAuth login required)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_NAME="Platform Admin"

# Automatically invited to every discovery call / platform meeting booking (calendar invite only — no confirmation email)
MEETING_EXTRA_ATTENDEE_EMAIL=
MEETING_EXTRA_ATTENDEE_NAME="Meeting Member"

MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# app_only = server uses .env keys only (no frontend Connect button)
# oauth = admin sign-in via /admin/sessions; auto = oauth if connected else app_only
MICROSOFT_AUTH_MODE=app_only
MENTOR_SLOT_DURATION_MINUTES=30
DEFAULT_TIMEZONE=Europe/London
WORKING_HOURS_START=09:00
WORKING_HOURS_END=17:00

# Zoom Server-to-Server OAuth (optional — for Zoom meeting bookings)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_BASE_URL=https://api.zoom.us/v2
ZOOM_AUTH_URL=https://zoom.us/oauth/token
# ZOOM_USER_ID=me

# SSL for Microsoft Graph on Windows local dev (use true in production)
# Option 1: disable verify locally only
# MICROSOFT_HTTP_VERIFY_SSL=false
# Option 2: point to CA bundle (recommended) — run: php artisan microsoft:install-ca-bundle
# CURL_CA_BUNDLE=

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Microsoft Clarity Data Export API (admin Google Analytics dashboard + daily cron)
GOOGLE_ANALYTICS_URL=https://www.clarity.ms/export-data/api/v1/project-live-insights
GOOGLE_ANALYTICS_ID=
CLARITY_TIMEZONE=Europe/London
CLARITY_NUM_OF_DAYS=1
CLARITY_FAILURE_ALERT_EMAIL=dilani@globaltechdevelop.com

# Training agreement — academy auto-signature (from Freedom_Property_Academy_Training_Agreement.docx)
TRAINING_AGREEMENT_SIGNATORY_NAME="Andrei Bosancu"
TRAINING_AGREEMENT_SIGNATORY_POSITION=CEO
# TRAINING_AGREEMENT_SIGNATURE_PATH=resources/agreements/academy_signature.png
TRAINING_AGREEMENT_ADMIN_EMAIL=admin@freedompropertyacademy.com

# InfinitWizard SSO
INFINITWIZARD_API_URL=
INFINITWIZARD_APP_API_KEY=

